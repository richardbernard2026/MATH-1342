# Copy this file to .env.local for local development.
# .env.local is gitignored and must NEVER be committed.
#
# On Vercel, set this in Project Settings -> Environment Variables instead.

# Groq API key, powers the AI Tutor page.
# Get a free one at https://console.groq.com/keys
# The app works fine without it; the tutor page just shows a "not connected" notice.
GROQ_API_KEY=
